#!/bin/sh
# Regenerates packages/core/openapi.json, apps/cloudflare-worker/public/*, packages/grid-aware/src/client.gen.ts,
# and syncs the version from root package.json before every commit, so CI's
# "generated files are stale" check never fires.
set -e

npm run generate --silent

git add \
  packages/core/openapi.json \
  apps/cloudflare-worker/public/index.html \
  apps/cloudflare-worker/public/grid-aware/index.js \
  apps/cloudflare-worker/public/grid-aware/blocking.js \
  packages/grid-aware/src/client.gen.ts \
  apps/cloudflare-worker/package.json \
  packages/core/package.json \
  packages/grid-aware/package.json \
  packages/grid-aware/jsr.json \
  packages/cli/package.json \
  packages/cli/jsr.json \
  integrations/docker-plugin/package.json \
  integrations/gate/package.json
