#!/bin/sh
# Regenerates worker/openapi.json, worker/public/*, and packages/grid-aware/src/client.gen.ts
# from source before every commit, so CI's "generated files are stale" check never fires.
set -e

npm run generate --silent

git add \
  worker/openapi.json \
  worker/public/index.html \
  worker/public/grid-aware/index.js \
  worker/public/grid-aware/blocking.js \
  packages/grid-aware/src/client.gen.ts
