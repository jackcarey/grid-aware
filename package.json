{
  "name": "grid-aware",
  "version": "2.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "sync-version": "node scripts/sync-version.mjs",
    "generate:openapi": "npm run generate:openapi --workspace packages/core",
    "generate:client": "npm run generate:client --workspace packages/grid-aware",
    "generate:site": "npm run generate:site --workspace apps/cloudflare-worker",
    "generate": "npm run sync-version && npm run generate:openapi && npm run generate:client && npm run generate:site",
    "build:cli": "npm run build --workspace packages/cli",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "dev": "npm run dev --workspace apps/cloudflare-worker"
  }
}
